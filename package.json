{
  "name": "babysleep-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "build:mobile": "npm run build -w @babysleep/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:private-data": "node tools/check-no-private-data.mjs",
    "check": "npm run check:private-data && node tools/build-supabase-setup.mjs --check && node tools/check-backup-shim.mjs && npm run check:contrast && npm run typecheck && npm run test",
    "build:supabase-sql": "node tools/build-supabase-setup.mjs",
    "visual": "playwright test -c tools/visual/playwright.config.ts",
    "check:contrast": "node tools/check-contrast.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
